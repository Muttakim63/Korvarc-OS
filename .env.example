# KORVARC OS Environment Configuration
# Copy this file to .env and configure your values.
# Note: You can also configure API keys and models directly inside the KORVARC OS UI in the Settings page.

# Dual AI Provider Credentials
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model Selection Defaults (editable in app)
DEFAULT_AI_PROVIDER=openai
OPENAI_DEFAULT_MODEL=gpt-4o-mini
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022

# Cost Safeguards
MAX_COST_PER_REQUEST_USD=0.15

# Agency & Sender Identity
# Sender first name is optional. If left blank, generated emails remain unsigned without fake placeholders.
KORVARC_SENDER_FIRST_NAME=
KORVARC_AGENCY_LOCATION=Ontario, Canada

# Database Configuration
KORVARC_DB_PATH=korvarc.db

